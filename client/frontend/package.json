{
  "name": "novelforge-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "design:lint": "node scripts/design-lint.mjs",
    "design:cross": "node ../../scripts/design-cross.mjs",
    "design:check": "npm run design:lint && DESIGN_PARITY=1 playwright test e2e/design-parity.spec.ts",
    "e2e:sweep": "node scripts/sweep-e2e-residue.mjs --apply",
    "e2e:sweep:dry": "node scripts/sweep-e2e-residue.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.10"
  }
}
