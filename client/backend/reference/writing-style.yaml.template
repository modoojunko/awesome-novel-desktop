# writing-style.yaml - 写作风格指南
#
# 建书只播种「通用 AI 腔护栏」：banned_words（禁用词）与 tic_patterns（句式规则）。
# 三区（叙事身份 / 硬约束 / 描写手法）SHALL 留空——由作者自己写，或在文风面板
# 右栏点「按题材填文风」从知识库取同题材的起点（采纳后才写进表单，可撤销）。
#
# 旧版曾在此播种 58 条通用原则与默认人设（core_principles / possible_mistakes /
# depiction_techniques / tone 等），已随 c-style-kb-fill 退役：新书打开文风页
# 不再被预填一堆。存量书的 KV 仍是旧形状，读路径 normalize_style 会照常归一。

# 建书向导的一次性提示（R9：不是题材源；题材以题材目录为唯一事实源）
genre_profile: ""

# 写作模型（novel.ai_model 是唯一权威源，本键只是旧字段保留）
writing_model: "sonnet"

# ── 三区（留空：作者写，或按题材从知识库填）──────────────────────────
role: ""
rules: []
craft: []
few_shot_examples: []
style_samples: []

# ============================================================
# 禁用词与句式规则（banned-words-into-style 收编：anti-ai 面板退役，
# 7 分类疲劳词展平为词表、structural_tic_patterns 平移为句式规则。
# 与写章提示词「原则与禁忌」段、quality 程序化体检单源。）
# ============================================================
banned_words:
  - "本章讲述了"
  - "接下来"
  - "在这一章中"
  - "故事还在继续"
  - "与此同时"
  - "另一方面"
  - "他感到"
  - "他觉得"
  - "他意识到"
  - "他注意到"
  - "他明白"
  - "他知道"
  - "综上所述"
  - "总而言之"
  - "从某种意义上说"
  - "不可否认"
  - "显而易见"
  - "深吸一口气"
  - "咬了咬牙"
  - "握紧拳头"
  - "眼中闪过一丝"
  - "嘴角勾起一抹"
  - "心中暗道"
  - "阳光透过树叶"
  - "月光洒在大地"
  - "微风拂过"
  - "夜幕降临"
  - "天刚蒙蒙亮"
  - "由此可见"
  - "正因如此"
  - "不仅如此"
  - "首先...其次...最后"
  - "似乎"
  - "也许"
  - "大概"
  - "仿佛"
  - "宛如"

tic_patterns:
  - pattern: '不是[^，。,\.]{1,20}(而是|是)'
    name: "不是而是句式"
    threshold: 3
    severity: "high"
    description: "过度使用'不是X，而是Y'对比句式——LLM 生成中文最顽固的统计癖好。直接删除'不是'分句，只保留'而是'后的内容"
  - pattern: "没有.{1,20}(只不过|只是|而是)"
    name: "没有X只是Y句式"
    threshold: 3
    severity: "medium"
    description: "'没有X，只是Y'——'不是而是'的变体，直接写Y"
  - pattern: '(不[,，]?\s*不是这样|其实并非如此|更准确[地性]说|不[,，]?\s*[他她它那这])'
    name: "否定-纠正句式"
    threshold: 2
    severity: "high"
    description: "先否定再纠正的统计癖好。删除否定-纠正前缀，直接陈述事实"
  - pattern: "——(他|她|它|这|那)"
    name: "破折号解释句式"
    threshold: 5
    severity: "medium"
    description: "破折号后接代词展开解释——适度是风格，过度是癖好"
  - pattern: "(不由得|不禁|忍不住|不由自主地|下意识地|鬼使神差地)"
    name: "公式化副词"
    threshold: 4
    severity: "high"
    description: "用副词替代真正的情绪描写。删掉副词，用具体的身体反应或动作替代"
  - pattern: "一边.{1,20}一边"
    name: "一边一边句式"
    threshold: 2
    severity: "medium"
    description: "并列动作结构让描写扁平化。拆成两个独立动作或用一个主动作带一个细节"
  - pattern: "(就在这时|正在这时|突然[，,])"
    name: "就在这时句式"
    threshold: 5
    severity: "medium"
    description: "模板感转场。删掉过渡词直接写事件，或换一种转场方式"
  - pattern: "(他眼神|她眼神|目光|瞳孔|眼神|心头|心里|心中|心底|手心|指尖|喉咙).{0,10}(一|微|暗|沉|紧|颤|抖|缩|松|暖|寒|凉|热|酸)"
    name: "身体部位情绪模板"
    threshold: 6
    severity: "high"
    description: "'眼神一暗''心里一沉''喉咙发紧'——固定身体反应模板。用具体动作替代：恐惧可以是'他把打火机按了三次才点着'"
