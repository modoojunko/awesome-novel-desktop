# Awesome Novel — Environment Configuration
#
# Only values that MUST differ per-deployment belong here.
# All other settings (AI model, API keys, etc.) are configured
# through the C端 UI at runtime and stored in config.json.

# Security: Change these before deploying!
JWT_SECRET=change-me-in-production
ADMIN_TOKEN=change-me-in-production
CORS_ORIGINS=*

# C端 storage (local dev only — packaged app uses its own default)
# DATA_ROOT=./data

# S端 CloudBase API (only needed if running C端 in production OAuth mode)
# SERVER_API_BASE=https://your-cloudbase-app.com/api

# S端 私有仓检出（本地全栈/跨端对拍需要；packaged app 不需要）
# S_SERVER_DIR=../<S端私有仓检出>/server
